<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Debug/local-testing entitlements for the MAS build variant.

  Identical to entitlements_mas.plist, plus
  com.apple.security.get-task-allow so a debugger (lldb/Xcode) can
  attach to the sandboxed process during local development.

  DO NOT use this file for the App Store Connect submission build —
  get-task-allow is rejected by App Review. Use entitlements_mas.plist
  (without get-task-allow) for the release/upload build.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Debug-only: allows a debugger to attach. Strip for release. -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
